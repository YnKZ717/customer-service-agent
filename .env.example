# API 配置（任何兼容 OpenAI 格式的服务都可以）
# 常用选择：
#   DeepSeek:  BASE_URL=https://api.deepseek.com/v1      MODEL=deepseek-chat
#   OpenAI:    BASE_URL=https://api.openai.com/v1        MODEL=gpt-4o
#   本地Ollama: BASE_URL=http://localhost:11434/v1        MODEL=llama3
#   阿里云:    BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

OPENAI_API_KEY=你的API密钥
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL_NAME=deepseek-chat

# 备用模型（主模型挂了自动切换，留空则不启用）
FALLBACK_API_KEY=
FALLBACK_BASE_URL=
FALLBACK_MODEL_NAME=gpt-3.5-turbo

# API 鉴权 Key（前后端共用，生产环境请改复杂）
API_KEY=neowow-dev-2026
